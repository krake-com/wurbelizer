<?xml version="1.0" encoding="UTF-8"?>
<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="Wurbelizer">

  <skin>
    <groupId>org.apache.maven.skins</groupId>
    <artifactId>maven-fluido-skin</artifactId>
    <version>${maven.fluido.skin.version}</version>
  </skin>

  <bannerLeft name="Wurbelizer" href="https://wurbelizer.org">
    <image src="images/logo-wurbelizer.png" alt="Wurbelizer"/>
  </bannerLeft>

  <body>
    <!-- Inherited by every module; the module name is appended automatically. -->
    <breadcrumbs>
      <item name="Wurbelizer" href="https://wurbelizer.org"/>
    </breadcrumbs>

    <menu name="Wurbelizer" inherit="top">
      <item name="Documentation" href="https://wurbelizer.org"/>
      <item name="Source (GitHub)" href="https://github.com/krake-com/wurbelizer/"/>
      <item name="Krake Softwaretechnik" href="https://krake.de"/>
    </menu>

    <!-- Auto-generated navigation provided by the site plugin. -->
    <menu ref="modules"/>
    <menu ref="reports"/>
  </body>

  <custom>
    <fluidoSkin>
      <sourceLineNumbersEnabled>true</sourceLineNumbersEnabled>
      <breadcrumbDivider>&#187;</breadcrumbDivider>
      <skipGenerationDate>false</skipGenerationDate>
    </fluidoSkin>
  </custom>

</site>
